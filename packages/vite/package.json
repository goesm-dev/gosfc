{
  "name": "@gosfc/vite",
  "version": "0.0.1-beta.7",
  "description": "Vite plugin that compiles <script setup lang=\"go\"> in Vue SFCs and Go in .astro files through goesm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goesm-dev/gosfc.git",
    "directory": "packages/vite"
  },
  "homepage": "https://goesm.dev/gosfc",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./vue-language-plugin": "./src/vue-language-plugin.cjs"
  },
  "files": [
    "README.md",
    "src",
    "runtime"
  ],
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@vue/compiler-sfc": "^3.5.0",
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}