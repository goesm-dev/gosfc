{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["gosfc.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "vueCompilerOptions": {
    "plugins": ["@gosfc/vite/vue-language-plugin"]
  }
}
